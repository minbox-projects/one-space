{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "OneSpace",
  "version": "0.1.56",
  "identifier": "com.onespace.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node src-tauri/scripts/build-zen-relay.mjs --dev && npm run dev",
    "beforeBuildCommand": "node src-tauri/scripts/build-zen-relay.mjs --release && npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "OneSpace",
        "width": 1370,
        "height": 870,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' http://127.0.0.1 http://localhost ws://127.0.0.1 ws://localhost https://api.github.com https://gmail.googleapis.com https://oauth2.googleapis.com https://accounts.google.com https://www.gstatic.com https://www.36kr.com https://www.oschina.net; media-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/onespace-zen-relay"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../server/onespace-cloud-agent/deploy.sh": "cloud-agent/deploy.sh",
      "../server/onespace-cloud-agent/bootstrap.sh": "cloud-agent/bootstrap.sh",
      "../server/onespace-cloud-agent/VERSION": "cloud-agent/VERSION",
      "../server/onespace-cloud-agent/config.default.json": "cloud-agent/config.default.json",
      "../server/onespace-cloud-agent/config.example.json": "cloud-agent/config.example.json",
      "../server/onespace-cloud-agent/agent.py": "cloud-agent/agent.py",
      "../server/onespace-cloud-agent/core/__init__.py": "cloud-agent/core/__init__.py",
      "../server/onespace-cloud-agent/core/disk_guardian.py": "cloud-agent/core/disk_guardian.py",
      "../server/onespace-cloud-agent/core/gateway.py": "cloud-agent/core/gateway.py",
      "../server/onespace-cloud-agent/core/issue_worker.py": "cloud-agent/core/issue_worker.py",
      "../server/onespace-cloud-agent/core/notifier.py": "cloud-agent/core/notifier.py",
      "../server/onespace-cloud-agent/core/session_runner.py": "cloud-agent/core/session_runner.py",
      "../server/onespace-cloud-agent/systemd/onespace-cloud-agent.service": "cloud-agent/systemd/onespace-cloud-agent.service"
    },
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/minbox-projects/one-space/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzMzlGOThEMzM2MzlFOEIKUldTTG5tTXpqZms1RTdmL1pzSVJGR1N4MnBocklYUTJzeVlSdktKb1JaZzJpUkFuakpDVytjbkYK"
    }
  }
}
