{
  "ai_gateway": {
    "port": 17688,
    "auto_sync_interval_seconds": 3600,
    "auth": {
      "require": false
    },
    "max_body_bytes": 10485760,
    "retry": {
      "max_cooldown_seconds": 600
    },
    "providers": {},
    "model_pools": {}
  },
  "issue_worker": {
    "enabled": false,
    "watch_repositories": [],
    "trigger_label": "bot:task",
    "require_author_permission": true,
    "permission_cache_seconds": 600,
    "max_attempts": 3,
    "poll_interval_seconds": 180,
    "workspace_root": "/root/cloud-agent-workspaces"
  },
  "notification": {
    "enabled": false
  },
  "runtime": {
    "disk_check_interval_seconds": 300,
    "shutdown_grace_seconds": 300
  },
  "guardian": {
    "data_roots": [
      "~/.local/share/opencode",
      "~/.cache/opencode"
    ],
    "cache_retention_days": 7,
    "cleanup_sessions": false,
    "worktree_retention_days": 7
  }
}
